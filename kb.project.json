    },
    {
      "name": "Electron桌面应用",
      "path": "knowledge/工程平台/Electron桌面应用/",
      "kind": "client"
    }
  ],
  "feishu": {
    "enabled": true,
    "envPath": ".cursor/hooks/feishu.env"
  },
