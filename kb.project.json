    },
    {
      "name": "Electron 主进程",
      "path": "electron/",
      "kind": "server"
    },
    {
      "name": "资源模板",
      "path": "resources/",
      "kind": "config"
    }
  ],
  "engineeringPlatforms": [
    {
      "name": "Daemon守护进程",
      "path": "knowledge/工程平台/Daemon守护进程/",
