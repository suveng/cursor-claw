{
  "name": "cursor-claw",
  "version": "1.13.7",
  "description": "Cursor Claw - 飞书 & 微信 × Cursor AI 协作桌面应用",
  "keywords": [
    "mcp",
    "wechat",
    "clawbot",
    "ilink",
    "cursor",
    "electron",
    "desktop"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lk-eternal/cursor-claw.git"
  },
  "type": "module",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "clean": "rimraf dist",
    "build:mcp": "tsc",
    "build:bundle": "node scripts/bundle-daemon.cjs",
    "dev:mcp": "tsx src/index.ts",
    "dev": "npm run build && electron-vite dev -- --profile=dev",
    "dev:multi": "electron-vite dev --",
    "dev:fresh-setup": "node scripts/dev-fresh-setup.cjs",
    "build": "npm run clean && npm run build:mcp && npm run build:bundle && electron-vite build",
    "preview": "electron-vite preview",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "node scripts/deploy/mac.cjs --mode=dist",
    "pack:win": "npm run build && electron-builder --win --dir",
    "pack:mac": "node scripts/deploy/mac.cjs --mode=pack",
    "pack:linux": "npm run build && electron-builder --linux --dir"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.195",
    "@cursor/sdk": "^1.0.22",
    "@larksuiteoapi/node-sdk": "^1.67.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@openai/codex-sdk": "^0.142.4",
    "@opencode-ai/sdk": "^1.17.11",
    "cron-parser": "^5.5.0",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.3",
    "lucide-react": "^0.577.0",
    "node-cron": "^4.2.1",
    "qrcode": "^1.5.4",
    "semver": "^7.7.4",
    "yaml": "^2.9.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/semver": "^7.7.1",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^41.0.3",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.27.4",
    "pg": "^8.20.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^7.3.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "optionalDependencies": {
    "@anthropic-ai/claude-agent-sdk-darwin-arm64": "0.3.195",
    "@anthropic-ai/claude-agent-sdk-darwin-x64": "0.3.195",
    "@anthropic-ai/claude-agent-sdk-linux-arm64": "0.3.195",
    "@anthropic-ai/claude-agent-sdk-linux-x64": "0.3.195",
    "@anthropic-ai/claude-agent-sdk-win32-x64": "0.3.195"
  },
  "overrides": {
    "axios": "^1.15.0"
  }
}
